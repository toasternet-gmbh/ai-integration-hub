# Copy to .env.supabase and fill in — read by deploy.sh (see yogaipilot/deploy.sh --init-env for
# the full template this one is trimmed from; this project needs a subset).

VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="ai-integration-hub"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

VITE_MAIN_DOMAIN="hub.yourdomain.com"
DEPLOY_BRANCH="main"
VITE_LOCAL_FUNCTIONS_PORT="60000"

FRONTEND_URL="https://hub.yourdomain.com"
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="changeme_use_strong_password"

# AES-256-GCM key for encrypting integration credentials at rest (32 raw bytes, base64).
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# Optional — only needed to enable the 'gocardless' banking platform. From the GoCardless Bank
# Account Data user secrets portal (one Hub-wide app credential, not per-integration).
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""
