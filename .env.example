# Copy to .env.supabase and fill in — read by deploy.sh (see yogaipilot/deploy.sh --init-env for
# the full template this one is trimmed from; this project needs a subset).

VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="ai-integration-hub"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

VITE_MAIN_DOMAIN="hub.yourdomain.com"
DEPLOY_BRANCH="main"
VITE_LOCAL_FUNCTIONS_PORT="60000"

FRONTEND_URL="https://hub.yourdomain.com"
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="changeme_use_strong_password"

# AES-256-GCM key for encrypting integration credentials at rest (32 raw bytes, base64).
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# Optional — only set while rotating CREDENTIALS_ENCRYPTION_KEY. Holds the key(s) being retired
# (comma-separated if rotating through more than one), kept live for decrypt-only so old rows keep
# working until scripts/reencrypt-credentials.ts has rewritten them under the new key. Remove once
# that script reports zero failures — see its header comment for the full procedure.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=""

# Optional — only needed to enable the 'gocardless' banking platform. From the GoCardless Bank
# Account Data user secrets portal (one Hub-wide app credential, not per-integration).
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""

# Optional — only needed to enable the 'outlook' productivity platform (calendar + mail via
# Microsoft Graph). From an Entra ID app registration with a web redirect URI pointing at
# <frontend>/app/integrations/oauth-callback and the Mail.Read/Mail.Send/Calendars.ReadWrite/
# offline_access delegated permissions granted. One Hub-wide app credential, not per-integration —
# each project's own integration still gets its own access/refresh token pair.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional — restricts sign-in to one Entra ID tenant instead of any Microsoft account. Defaults
# to "common" (both work/school and personal accounts) if unset.
MICROSOFT_TENANT_ID=""

# Optional — only needed to enable the 'google' productivity platform (calendar + mail via Gmail +
# Calendar APIs). From a Google Cloud OAuth 2.0 client (Web application type) with a redirect URI
# pointing at <frontend>/app/integrations/oauth-callback and the Gmail/Calendar scopes added to
# the consent screen. One Hub-wide app credential, not per-integration.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
